# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=trampocerto
MYSQL_USER=trampo_user
MYSQL_PASSWORD=trampo_password
MYSQL_PORT=3308

# Backend Configuration
PORT=4000
DATABASE_HOST=localhost
DATABASE_PORT=3308
BETTER_AUTH_SECRET=trampo_certo_jwt_secret_dev_key_987654321
BETTER_AUTH_URL=http://localhost:4005
FRONTEND_URL=http://localhost:3000

# Conta criada no primeiro boot (senha real, com hash do Better Auth).
# Deixe em branco para subir sem nenhuma conta pré-criada.
#
# DEMO_USER_EMAIL também define o ADMINISTRADOR do app: é a única conta que
# enxerga /admin e pode trocar plano, bloquear e excluir usuários. Com a
# variável vazia, ninguém é administrador e /api/admin fica inacessível.
DEMO_USER_NAME=Rodrigo Silva
DEMO_USER_EMAIL=rodrigo@trampocerto.com.br
DEMO_USER_PASSWORD=trampocerto123

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4005
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:4005

# ----------------------------------------------------------------------------
# Produção (Coolify) — o docker-compose.yml lê estas variáveis.
# Em dev, o docker-compose.override.yml sobrescreve o que precisa.
# ----------------------------------------------------------------------------

# URL pública do app, com https em produção. Também é a base do Better Auth,
# já que /api/* é servido pelo mesmo domínio (proxy do Next).
APP_URL=http://localhost:3000

# Só preencha se a API tiver domínio próprio (ex.: https://api.seudominio.com).
# Vazio = o navegador usa a mesma origem do app.
API_URL=

# Origens externas liberadas no CORS (lista separada por vírgula).
# Vazio = apenas a mesma origem; suficiente com o proxy do app.
FRONTEND_URL=

# Ajuste apenas se app e API ficarem em domínios diferentes:
# AUTH_COOKIE_SAMESITE=none
# AUTH_COOKIE_DOMAIN=.seudominio.com

TZ=America/Sao_Paulo
